# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

PROJECT_NAME=Chromite API
VERSION=1.0.0
API_V1_STR=/api/v1

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_...). Safe for client use, still subject to RLS.
SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
# Secret key (sb_secret_...). Backend only. Bypasses RLS. Never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY

# Comma-separated or JSON list of allowed browser origins. Wildcard "*" is rejected
# when credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Interactive API docs (default: on, except APP_ENV=production)
# DOCS_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20
# Reverse proxies whose X-Forwarded-For is trusted (IPs/CIDRs). Empty = trust none.
TRUSTED_PROXIES=
